# ==============================================================
# Freight Link Network — Environment Variables
# ==============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================

# Supabase project settings (find these in: Supabase Dashboard → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox (find this in: Mapbox Account → Access Tokens)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.example

# Site URL (used for auth redirects — must match Supabase Auth → URL Configuration → Site URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================
# SMTP credentials — set these in Supabase Edge Function secrets
# (Supabase Dashboard → Project → Edge Functions → send-email → Secrets)
# DO NOT put these in .env.local — they belong server-side only.
# ==============================================================
# SMTP_HOST=mail.yourdomain.co.za
# SMTP_PORT=587
# SMTP_USER=noreply@freightlinknetwork.co.za
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Freight Link Network <noreply@freightlinknetwork.co.za>
